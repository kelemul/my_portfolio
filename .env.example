### Example environment variables for local development and Vercel
# Copy this file to `.env.local` for local dev or set these as Vercel Environment Variables

# MongoDB connection string (include credentials & replica set options if needed)
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.mongodb.net/myFirstDatabase?retryWrites=true&w=majority

# Optional: database name (defaults to `portfolio_db`)
MONGODB_DB=portfolio_db

# Admin compatibility and JWT secret
ADMIN_PASSWORD=changeme
ADMIN_JWT_SECRET=replace-with-a-strong-secret

# Optional: during local dev, point frontend to API server
VITE_API_BASE=http://localhost:3000
